# ============================================================
# Onyx Scrapper — environment variable configuration
# ============================================================
# Copy this file to .env and fill in the values you need.
# docker compose reads .env automatically — no editing of
# docker-compose.yml required.
#
# Lines starting with # are comments; commented-out variables
# show the default value and are entirely optional.
# ============================================================


# ── Web UI port ──────────────────────────────────────────────────────────────
# Port exposed on your host machine. Open http://localhost:9090 after starting.
# ONYX_PORT=9090


# ── Docker image ──────────────────────────────────────────────────────────────
# Which image tag to pull. Change to a specific version (e.g. v1.0.0) to pin.
# DOCKER_IMAGE=kaiizer777/onyx-scrapper:latest


# ── ScraperAPI (optional) ─────────────────────────────────────────────────────
# Paid fallback fetch provider used when direct HTTP and headless Chrome both
# fail (e.g. heavy anti-bot sites). Leave blank to disable.
# Sign up at https://www.scraperapi.com/ to get a key.
# SCRAPERAPI_KEY=


# ── Telegram Bot Gateway (optional) ───────────────────────────────────────────
# Enables the Telegram chat interface so you can run research from your phone.
# 1. Talk to @BotFather on Telegram → /newbot → copy the token below.
# 2. Set telegram.enabled: true in config.yaml (or mount your own config.yaml).
# This env var takes precedence over telegram.bot_token in config.yaml.
# TELEGRAM_BOT_TOKEN=


# ── SearXNG URL (internal — do not change unless you run a separate SearXNG) ──
# Inside docker compose, onyx reaches SearXNG via its service name.
# This is already set correctly in docker-compose.yml; override only if you
# run your own SearXNG outside of docker compose.
# SEARXNG_URL=http://searxng:8080
