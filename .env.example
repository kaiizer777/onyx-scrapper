# Copy to `.env` and fill in. The Onyx binary reads env vars at startup;
# do NOT commit `.env` itself (it's in .gitignore).

# ── LLM (OpenCode Zen) ───────────────────────────────────────────────────────
# Required. The base URL and a real API key from your OpenCode Zen account.
# ONYX_LLM_BASE_URL=https://opencode.ai/zen/v1
# ONYX_LLM_API_KEY=

# ── ScraperAPI (optional) ────────────────────────────────────────────────────
# Used by the registry's "scraperapi" fetch provider as a fallback path.
# SCRAPERAPI_KEY=

# ── Jina (optional) ──────────────────────────────────────────────────────────
# Used by the "jina" fetch/search provider and (optionally) the reranker.
# JINA_API_KEY=

# ── TinyFish (optional) ──────────────────────────────────────────────────────
# TINYFISH_API_KEY=

# ── Telegram Gateway (Phase 2) ───────────────────────────────────────────────
# Token from @BotFather. Required when config.yaml has `telegram.enabled: true`.
# This env var takes precedence over `telegram.bot_token` in config.yaml.
TELEGRAM_BOT_TOKEN=

# ── News Mode (Phase 11) ─────────────────────────────────────────────────────
# News mode is intentionally keyless. The primary headline source is
# Google News RSS (news.google.com/rss/search) which requires no API key
# and no signup. Operators do NOT need to configure NEWSAPI_KEY, GNEWS_KEY,
# NEWSDATA_KEY, or any other paid news API to run /news or .\onyx.exe news.
# The fallback chain (SearXNG news category, TinyFish Search) reuses the
# existing discovery layer, so no new credentials are required.
#
# Cost guardrails live in config.yaml under `news:`:
#   - max_fields (default 10) — refuse a /news run whose profile has
#     too many enabled fields
#   - max_articles_per_field (default 20) — per-field hard ceiling
#   - quality.max_extra_calls_per_run — dominant LLM/HTML-pull budget
# NEWSAPI_KEY=
# GNEWS_KEY=
# NEWSDATA_KEY=
